# Backend
DATABASE_URL=postgres://postgres:postgres@localhost:5432/astrophage?sslmode=disable
JWT_SECRET=change-me
PORT=8080
CORS_ORIGIN=http://localhost:5173

# Analysis progress delay per stage (ms), so the stepper is visible in the demo
ANALYSIS_STEP_DELAY_MS=600

# LLM (optional, any OpenAI-compatible API). Without a key the app uses deterministic templates.
# Example with Groq: https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# gpt-oss models are reasoning models: "low" keeps them within the token budget. Leave empty for other models.
LLM_REASONING_EFFORT=low
